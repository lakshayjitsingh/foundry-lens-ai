# ==============================================================================
# FoundryLens AI — Microsoft Foundry / GitHub Models Configuration
# ==============================================================================
# Copy this file to `.env` and fill in EITHER Option A OR Option B.
# If left empty, FoundryLens AI automatically runs in Offline Demo Mode so the
# app remains 100% functional for classroom/viva demonstrations without Wi-Fi.

# --- Option A: Microsoft Foundry (Azure for Students / Azure AI Project) ---
# Example: https://<your-resource>.services.ai.azure.com/models
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_KEY=

# --- Option B: GitHub Models (Free Azure-Hosted Microsoft Foundry Catalog) ---
# Create a free GitHub PAT (with `models:read` permission) and paste it below.
# Uses endpoint: https://models.github.ai/inference
GITHUB_TOKEN=

# Default model from the Microsoft Foundry Model Catalog
DEFAULT_FOUNDRY_MODEL=gpt-4o-mini

# Allowed CORS origins (comma-separated, e.g. Vercel frontend URL)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
